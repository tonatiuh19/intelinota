# ============================================================
# Intelinota — environment variable template
# Copy to .env and fill in real values.
# ============================================================

# ----- Database (TiDB Cloud) ---------------------------------
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=intelinota
DB_SSL=true

# ----- Auth --------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Secret for /api/cron/publish-scheduled. Sent as "Authorization: Bearer <secret>"
# (Vercel Cron does this automatically) or "x-cron-secret" header. Never in the URL.
CRON_SECRET=
# HMAC key for admin login codes (falls back to JWT_SECRET). openssl rand -hex 32
OTP_SECRET=
# Salt for hashing visitor/commenter IPs (required). openssl rand -hex 32
VISITORS_SALT=
# Max MySQL connections per serverless instance
DB_POOL_LIMIT=3

# ----- Email (Resend) ----------------------------------------
# Verify your sending domain in the Resend dashboard first.
RESEND_API_KEY=
SMTP_FROM="Intelinota <no-reply@intelinota.com>"

# ----- App ---------------------------------------------------
PORT=8080
BASE_URL=http://localhost:8080

# SEO / social meta → edit client/lib/seoConfig.ts (not env vars)
# Analytics (GA4 / Plausible) → seoConfig.analytics in the same file

# ----- Media (Vercel Blob) -----------------------------------
# Created automatically when you add a Blob store in the Vercel dashboard.
# Without it, uploads fall back to DB storage (dev only).
BLOB_READ_WRITE_TOKEN=
