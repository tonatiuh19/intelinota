# ============================================================
# Intelinota — environment variable template
# Copy to .env and fill in real values.
# ============================================================

# ----- Database (MySQL 8.0) ----------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=intelinota

# ----- Auth --------------------------------------------------
JWT_SECRET=

# ----- Email (nodemailer / SMTP) -----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Intelinota <no-reply@intelinota.com>"

# ----- IMAP (optional) ---------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ----- App ---------------------------------------------------
PORT=8080
BASE_URL=http://localhost:8080
